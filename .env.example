# ==============================================================================
# Zoe Intelligence Engine & SaaS Platform — Environment Configuration Template
# ==============================================================================

# Core Application Settings
ZOE_ENV=production
LOG_LEVEL=INFO
CONFIG_DIR=config
DATA_DIR=data

# Security & Multi-Tenant Cryptography
# Shared secret for signing engine payloads between FastAPI and Bot Workers
ENGINE_SHARED_SECRET=your-32-byte-hex-shared-secret-here
# Secret key used for signing internal JWT tokens
JWT_SECRET=your-super-admin-jwt-secret-here

# Web3 Treasury & Payment Verification
# Solana wallet address for Super Admin platform subscriptions & invoice settlements
ZOE_SOLANA_WALLET=4C8deD4Tm8xuM5kkpkS8wn7shGgKejAMLyi6uwFkCkFA
# Optional custom Solana RPC (e.g. Helius, QuickNode, Triton)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=your-helius-api-key-optional

# Supabase Auth, PostgreSQL & Vector Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# AI Intelligence Models (Groq Primary, Gemini Fallback)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Discord Multi-Platform Integration (Optional)
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Twitter (X) Multi-Platform Poller (Optional)
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# DexScreener & On-Chain Security
DEXSCREENER_BASE_URL=https://api.dexscreener.com/latest/dex
GOPLUS_BASE_URL=https://api.gopluslabs.io/api/v1
